# Copy to deploy/loop.env and fill in. NEVER commit this file (it's gitignored).
#
# Your Claude subscription token — run `claude setup-token` on a machine with a browser,
# then paste the result here. This authenticates Claude Code to your Max/Pro plan so the
# loop reads ink on your subscription, not metered API tokens. Expires ~1 year; regenerate.
CLAUDE_CODE_OAUTH_TOKEN=

# Your notes repos (the source docs), one per scan_root, as `subpath=HTTPS_URL` pairs joined
# by commas. The subpaths MUST match SUPERNOTE_SCAN_ROOTS below. Applied ink edits are committed
# to the right repo and pushed back. (No token in these URLs — auth is GITHUB_TOKEN, below.)
DOCS_REPOS=RealtimeMFG=https://github.com/you/realtimemfg.git,hq=https://github.com/you/hq.git
SUPERNOTE_SCAN_ROOTS=RealtimeMFG,hq

# A GitHub fine-grained PAT with read+write "Contents" on those repos. Used via a git
# credential helper, so it never lands in a repo URL/.git/config/log. (Single repo? You can use
# an SSH deploy-key instead — see EC2-SETUP.md.)
GITHUB_TOKEN=github_pat_...

# --- optional ---
# RUN_MODE=loop               # loop = self-scheduled (default); oneshot = one pass then exit
#                             # (use oneshot when an external trigger drives it — host cron
#                             #  for scheduled runs, or the heartbeat for on-demand)
# HEARTBEAT_STALE_SECS=300    # hybrid: stand down while the laptop's watcher is active (it
#                             # stamps .laptop-alive every ~60s); the cloud only runs once that
#                             # heartbeat is older than this. Set 0 to disable (cloud-only setup).
# RCLONE_REMOTE=gdrive        # name of the rclone remote in rclone.conf (default: gdrive)
# LOOP_INTERVAL=300           # seconds between sync passes in loop mode (default: 300 = 5 min)
# GIT_USER_NAME=supernote-sync
# GIT_USER_EMAIL=supernote-sync@localhost
# Override the Supernote folder path inside the mounted Drive if yours differs (rclone roots
# the drive remote at "My Drive", so the folder is directly under /drive):
# SUPERNOTE_ROOT=/drive/Supernote
